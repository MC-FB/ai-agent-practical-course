{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.api:app", "--port", "8001"],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set \"VITE_API_PROXY_TARGET=http://127.0.0.1:8001\" && npm --prefix app/web run dev"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
